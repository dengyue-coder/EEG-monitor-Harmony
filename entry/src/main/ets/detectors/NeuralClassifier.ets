// ============================================================
//  MLP 前向推理 (纯 TypeScript, 零依赖)
// ============================================================
function dot(w: number[], x: number[]): number {
  let s = 0;
  for (let i = 0; i < w.length; i++) s += w[i] * x[i];
  return s;
}

function matVecMulAdd(W: number[][], x: number[], b: number[]): number[] {
  const out = new Array<number>(b.length);
  for (let r = 0; r < W.length; r++) {
    out[r] = dot(W[r], x) + b[r];
  }
  return out;
}

function relu(z: number[]): number[] {
  for (let i = 0; i < z.length; i++) {
    if (z[i] < 0) z[i] = 0;
  }
  return z;
}

function softmax(logits: number[]): number[] {
  let maxV = logits[0];
  for (let i = 1; i < logits.length; i++) {
    if (logits[i] > maxV) maxV = logits[i];
  }
  let sum = 0;
  const probs = new Array<number>(logits.length);
  for (let i = 0; i < logits.length; i++) {
    probs[i] = Math.exp(logits[i] - maxV);
    sum += probs[i];
  }
  for (let i = 0; i < probs.length; i++) {
    probs[i] /= sum;
  }
  return probs;
}

function normalize(feats: number[]): number[] {
  const out = new Array<number>(10);
  for (let i = 0; i < 10; i++) {
    out[i] = (feats[i] - MEAN[i]) / STD[i];
  }
  return out;
}

// 训练标签 0-8 → EmotionKind 映射
const LABEL_TO_EMOTION: EmotionKind[] = [
  EmotionKind.NEUTRAL,   // 0
  EmotionKind.HAPPY,     // 1
  EmotionKind.EXCITED,   // 2
  EmotionKind.FOCUSED,   // 3
  EmotionKind.RELAXED,   // 4
  EmotionKind.ANXIOUS,   // 5
  EmotionKind.SAD,       // 6
  EmotionKind.ANGRY,     // 7
  EmotionKind.TIRED,     // 8
];

export class NeuralClassifier {
  ready: boolean = true;

  /**
   * 分类: 输入 10 维特征 [d, t, aL, aH, bL, bH, gL, gM, att, med]
   * 返回 [情绪类别, 概率分布数组]
   */
  classify(feats: number[]): [EmotionKind, number[]] {
    const x = normalize(feats);
    let h = matVecMulAdd(W1, x, B1);
    h = relu(h);
    h = matVecMulAdd(W2, h, B2);
    h = relu(h);
    const logits = matVecMulAdd(W3, h, B3);
    const probs = softmax(logits);

    let bestIdx = 0;
    for (let i = 1; i < probs.length; i++) {
      if (probs[i] > probs[bestIdx]) bestIdx = i;
    }
    return [LABEL_TO_EMOTION[bestIdx], probs];
  }
}
